# ========================================
# ai-ceo-os Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- AI Provider ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- QA+ 라이브 웹 대본 엔진 ---
# 매 생성 시 식약처·식품안전나라·국가법령정보센터를 실시간 검색합니다.
# 칩섭을 우선 사용합니다. GitHub Actions에서는 CHIPSUB_API Secret을 CHEAPAI_API_KEY로 주입합니다.
CHEAPAI_API_KEY=your_cheapai_api_key_here
CHEAPAI_BASE_URL=https://api.cheapai.im/v1
CHEAPAI_STORY_MODEL=gpt-5.6-sol
CHEAPAI_STORY_FALLBACK_MODEL=claude-sonnet-5
QA_LLM_TIMEOUT_SECONDS=25
QA_WEB_MIN_SOURCE_COUNT=2
QA_SCRIPT_SIMILARITY_THRESHOLD=0.72

# 칩섭의 모든 재시도가 실패할 때만 사용하는 공식 OpenAI API 대체 경로입니다.
# GitHub Actions에서는 OFFICIAL_OPENAI_API_KEY Secret을 별도로 등록하세요.
OFFICIAL_OPENAI_API_KEY=your_official_openai_api_key_here
OFFICIAL_OPENAI_BASE_URL=https://api.openai.com/v1
OFFICIAL_OPENAI_STORY_MODEL=gpt-5-mini

# --- Social Media APIs ---
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_ad_account_id_here
META_IG_ACCESS_TOKEN=your_instagram_token_here

# --- Google ---
GOOGLE_ADS_CUSTOMER_ID=your_google_ads_customer_id_here
GA4_PROPERTY_ID=your_ga4_property_id_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Communication ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
SLACK_BOT_TOKEN=your_slack_bot_token_here

# --- QA+ Automation ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=owner/repository

# --- Database ---
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Deployment ---
VERCEL_TOKEN=your_vercel_token_here
